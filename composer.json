{
    "autoload": {
        "psr-4": {
            "DifferDev\\": "src/"
        }
    },
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "spatie/phpunit-watcher": "^1.24",
        "mockery/mockery": "^1.6",
        "infection/infection": "^0.35.8"
    },
    "scripts": {
        "test": "phpunit",
        "test:watch": [
            "Composer\\Config::disableProcessTimeout",
            "phpunit-watcher watch < /dev/tty"
        ],
        "test:coverage": "XDEBUG_MODE=coverage phpunit --coverage-html coverage",
        "infection": "infection"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
